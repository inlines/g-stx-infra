server {
    listen 80;

    # ============================================
    # АДСКИЕ ЛОВУШКИ ДЛЯ СКАНЕРОВ (без ошибок!)
    # ============================================
    
    # 1. PHP-ФАЙЛЫ: МЕДЛЕННЫЙ ОТВЕТ
    location ~ \.(php|asp|aspx|pl|py|jsp|sh|cgi)$ {
        # Медленно: 50 байт/сек
        limit_rate 50;
        
        # Фейковые заголовки
        add_header X-Powered-By "PHP/8.2.11";
        add_header Server "Apache/2.4.58";
        add_header Content-Type "text/html";
        
        # ПРОСТОЙ фейковый PHP (без переменных $)
        return 200 "<!--
  _____ _    _ _____  ______ _____  
 / ____| |  | |  __ \|  ____|  __ \ 
| (___ | |  | | |__) | |__  | |__) |
 \___ \| |  | |  ___/|  __| |  _  / 
 ____) | |__| | |    | |____| | \ \ 
|_____/ \____/|_|    |______|_|  \_\
                                    
SECURE ADMIN PANEL v4.2
===================================

WARNING: Authorized access only!
All unauthorized attempts are logged.

Initializing system...
[####################] 100%

System status: ONLINE
Users connected: 42
Security level: MAXIMUM
Last backup: 2024-01-01 12:00:00 UTC

Loading admin interface...
Please wait while we authenticate your session...

If you see this message for more than 30 seconds,
the system is performing additional security checks.

DEBUG INFO:
- Memory: 128MB/256MB (50%)
- CPU: 23%
- Database: Connected
- Firewall: Active
- Encryption: AES-256

<script>
// Эмуляция загрузки
let progress = 0;
const interval = setInterval(() => {
    progress += 1;
    console.log('Loading progress: ' + progress + '%');
    if (progress >= 100) {
        clearInterval(interval);
        console.log('Admin panel loaded successfully!');
    }
}, 300);
</script>
-->";
    }

    # 2. ЛОВУШКИ ДЛЯ АДМИНКИ
    location ~* ^/(admin|wp-admin|administrator|mysql|phpmyadmin|config|backup|wp-login|wp-content|wp-includes) {
        # Очень медленно: 10 байт/сек
        limit_rate 10;
        
        add_header Content-Type "text/html";
        
        return 200 '<!DOCTYPE html>
<html>
<head>
    <title>Loading Admin Panel</title>
    <meta http-equiv="refresh" content="30">
    <style>
        body { background: #000; color: #0f0; font-family: monospace; padding: 20px; }
        .loader { border: 5px solid #333; border-top: 5px solid #0f0; border-radius: 50%; width: 50px; height: 50px; animation: spin 2s linear infinite; margin: 20px auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <h1>🔐 ADMINISTRATOR ACCESS</h1>
    <div class="loader"></div>
    <pre>
Initializing security protocols...
Checking credentials...
Connecting to database...
Loading user permissions...
Verifying security tokens...
Establishing encrypted connection...

Status: AUTHENTICATING...
Estimated time: 30 seconds
Please wait...
    </pre>
    <script>
        // Простой счетчик
        let seconds = 0;
        setInterval(() => {
            seconds++;
            document.title = "Loading... (" + seconds + "s)";
        }, 1000);
    </script>
</body>
</html>';
    }

    # 3. ФЕЙКОВЫЕ API ДЛЯ СКАНЕРОВ
    location ~* ^/(api/v[0-9]|rest/v[0-9]|graphql|wp-json) {
        # Медленно: 20 байт/сек
        limit_rate 20;
        
        add_header Content-Type "application/json";
        
        return 200 '{"status":"success","message":"API is operational","data":{"version":"2.1.0","timestamp":1703894400}}';
    }

    # ============================================
    # ВАШ ОРИГИНАЛЬНЫЙ РАБОЧИЙ КОНФИГ
    # ============================================
    
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /static/ {
        root /var/www;
        try_files $uri $uri/ =404;
        
        # Оптимизация статики
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /api/ {
        proxy_pass http://backend:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    location /ws/ {
        proxy_pass http://backend:9090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. robots.txt
    location = /robots.txt {
        add_header Content-Type "text/plain";
        return 200 "User-agent: *
Allow: /
Disallow: /admin/
Disallow: /wp-admin/
Disallow: /config/
Sitemap: https://$host/sitemap.xml";
    }

    # 5. Защита скрытых файлов
    location ~ /\. {
        deny all;
        return 404;
    }
}