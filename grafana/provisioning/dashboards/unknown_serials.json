          "expr": "max by (platform,region) (gstx_unknown_games{job=\"igdb-sync\",platform=~\"${platform:regex}\",region=~\"${region:regex}\"}) and on() ((max(gstx_unknown_collection_success{job=\"igdb-sync\"}) == 1) and (time() - max(gstx_unknown_last_success_timestamp_seconds{job=\"igdb-sync\"}) < 900))",
