      "targets": [
        {
          "refId": "A",
          "expr": "max({job=\"postgres\",__name__=~\"pg_exporter_last_scrape_error\"}) + max(1 - pg_scrape_collector_success{job=\"postgres\"})",
          "legendFormat": "Ошибка",
